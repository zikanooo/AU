# Lokasi rekomendasi YouTube Music (kode negara 2 huruf). Default: ID (Indonesia)
YTM_LOCATION="ID"

# Negara untuk chart/trending. "ZZ" = global. Default mengikuti YTM_LOCATION
YTM_CHART_COUNTRY="ID"

# Port backend Python (default 8765). JANGAN 8888 -> itu port Jupyter, penyebab "Server error 404".
# BACKEND_PORT=8765

# Hanya jika frontend & backend di domain berbeda:
# VITE_API_BASE="https://api.domainmu.com"

# (Opsional) rekomendasi PERSONAL dari akun YouTube Music kamu:
# YTM_AUTH="backend/browser.json"
